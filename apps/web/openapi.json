            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "CreateTripRequest" : {
        "required" : [ "destArea", "destLat", "destLng", "exitAt", "terminalId" ],
        "type" : "object",
        "properties" : {
          "bags" : {
            "maximum" : 6,
            "minimum" : 0,
            "type" : "integer",
            "format" : "int32"
          },
          "destArea" : {
            "maxLength" : 120,
            "minLength" : 0,
            "type" : "string"
          },
          "destLat" : {
            "maximum" : 90,
            "exclusiveMaximum" : false,
            "minimum" : -90,
            "exclusiveMinimum" : false,
            "type" : "number",
            "format" : "double"
          },
          "destLng" : {
            "maximum" : 180,
            "exclusiveMaximum" : false,
            "minimum" : -180,
            "exclusiveMinimum" : false,
            "type" : "number",
            "format" : "double"
          },
          "exitAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "flightNo" : {
            "pattern" : "^$|^[A-Za-z0-9]{2} ?\\d{1,4}$",
            "type" : "string",
            "nullable" : true
          },
          "seats" : {
            "maximum" : 3,
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32"
          },
          "terminalId" : {
            "minLength" : 1,
            "type" : "string"
          },
          "womenOnly" : {
            "type" : "boolean"
          }
        }
      },
      "Created" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "FareRequest" : {
        "required" : [ "total" ],
        "type" : "object",
        "properties" : {
          "total" : {
            "maximum" : 10000,
            "exclusiveMaximum" : false,
            "minimum" : 50,
            "exclusiveMinimum" : false,
            "type" : "number"
          }
        }
      },
      "GroupView" : {
        "type" : "object",
        "properties" : {
          "bookerUpiId" : {
            "type" : "string",
            "nullable" : true
          },
          "fareTotal" : {
            "type" : "number",
            "nullable" : true
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "members" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MemberView"
            }
          },
          "sharingFrom" : {
            "type" : "string",
            "format" : "date-time"
          },
          "sharingUntil" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "open", "locked", "met" ]
          },
          "youAreBooker" : {
            "type" : "boolean"
          }
        }
      },
      "Keys" : {
        "required" : [ "auth", "p256dh" ],
        "type" : "object",
        "properties" : {
          "auth" : {
            "minLength" : 1,
            "type" : "string"
          },
          "p256dh" : {
