# Copy to infra/.env on the server (never commit it) and make it private: chmod 600 infra/.env
# Generate each secret with: openssl rand -base64 32

# The domain pointing at this server, e.g. namastute.in (use "localhost" for a local test)
DOMAIN=namastute.in

DB_PASSWORD=
JWT_SECRET=
OTP_HMAC_SECRET=

# Push notifications: one key pair, made once (commands in infra/README.md). Changing it later breaks everyone's subscriptions.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ID photos (Learning Notes 78): the private S3 bucket from infra/README.md "ID photos". No AWS keys here:
# the server's IAM role gives access.
S3_BUCKET=namastute-verification
AWS_REGION=ap-south-1

# Login codes by email (Learning Notes 88): the sender, on a domain verified in Amazon SES (infra/AWS-SETUP.md, section 15).
# Not needed in staging (prod,fake-sms); required with plain prod.
EMAIL_FROM=Namastute <login@namastute.in>

# prod = real login emails through SES. Staging and local tests: prod,fake-sms (login codes go to the API log)
SPRING_PROFILES_ACTIVE=prod
